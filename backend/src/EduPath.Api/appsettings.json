{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true,
    "SeedDemoData": true
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=App_Data/edupath.db",
    "Postgres": "Host=localhost;Port=5432;Database=edupath;Username=edupath;Password=edupath"
  },
  "Jwt": {
    "Issuer": "EduPath",
    "Audience": "EduPath.Web",
    "SigningKey": "",
    "ExpiresMinutes": 10080
  },
  "Payments": {
    "SimulatedLatencyMs": 700
  },
  "Storage": {
    "RootPath": "App_Data/files",
    "PublicPath": "/files"
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "PaymentsPerMinute": 10
  }
}
